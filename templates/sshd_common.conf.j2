{# Managed by Ansible — sunsong.common role. Do not edit by hand.       #}
{# Drop-in file: /etc/ssh/sshd_config.d/00-common.conf                #}
{# Source: sunsong.common/templates/sshd_common.conf.j2               #}
{#                                                                 #}
{# Each directive below is conditional. If a value in               #}
{# ssh_hardening is null, the directive is omitted and the distro  #}
{# default applies.                                                 #}
{#                                                                 #}
{# Booleans are emitted as `yes`/`no`, not `true`/`false` — sshd    #}
{# rejects `true`/`false` (only `yes`/`no` are valid for boolean    #}
{# directives). The `bool_yn` macro below centralizes the mapping.  #}
{% macro bool_yn(v) -%}
{{- 'yes' if v else 'no' -}}
{%- endmacro %}
{% set h = ssh_hardening | default({}) %}
{% if h.permit_root_login is not none %}PermitRootLogin {{ h.permit_root_login }}
{% endif %}
{% if h.password_authentication is not none %}PasswordAuthentication {{ bool_yn(h.password_authentication) }}
{% endif %}
{% if h.kbd_interactive_authentication is not none %}KbdInteractiveAuthentication {{ bool_yn(h.kbd_interactive_authentication) }}
{% endif %}
{% if h.pubkey_authentication is not none %}PubkeyAuthentication {{ bool_yn(h.pubkey_authentication) }}
{% endif %}
{% if h.permit_empty_passwords is not none %}PermitEmptyPasswords {{ bool_yn(h.permit_empty_passwords) }}
{% endif %}
{% if h.max_auth_tries is not none %}MaxAuthTries {{ h.max_auth_tries }}
{% endif %}
{% if h.login_grace_time is not none %}LoginGraceTime {{ h.login_grace_time }}
{% endif %}
{% if h.x11_forwarding is not none %}X11Forwarding {{ bool_yn(h.x11_forwarding) }}
{% endif %}
{% if h.allow_tcp_forwarding is not none %}AllowTcpForwarding {{ bool_yn(h.allow_tcp_forwarding) }}
{% endif %}
{% if h.allow_agent_forwarding is not none %}AllowAgentForwarding {{ bool_yn(h.allow_agent_forwarding) }}
{% endif %}
{% if h.allow_stream_local_forwarding is not none %}AllowStreamLocalForwarding {{ bool_yn(h.allow_stream_local_forwarding) }}
{% endif %}
{% if h.client_alive_interval is not none %}ClientAliveInterval {{ h.client_alive_interval }}
{% endif %}
{% if h.client_alive_count_max is not none %}ClientAliveCountMax {{ h.client_alive_count_max }}
{% endif %}
{% if h.max_sessions is not none %}MaxSessions {{ h.max_sessions }}
{% endif %}
{% if h.max_startups is not none %}MaxStartups {{ h.max_startups }}
{% endif %}
{% if h.use_dns is not none %}UseDNS {{ bool_yn(h.use_dns) }}
{% endif %}
{% if h.gssapi_authentication is not none %}GSSAPIAuthentication {{ bool_yn(h.gssapi_authentication) }}
{% endif %}
{% if h.gssapi_cleanup_credentials is not none %}GSSAPICleanupCredentials {{ bool_yn(h.gssapi_cleanup_credentials) }}
{% endif %}
{% if h.ciphers is not none %}Ciphers {{ h.ciphers }}
{% endif %}
{% if h.macs is not none %}MACs {{ h.macs }}
{% endif %}
{% if h.kex_algorithms is not none %}KexAlgorithms {{ h.kex_algorithms }}
{% endif %}
{% if h.allow_users is not none %}AllowUsers {{ h.allow_users }}
{% endif %}
{% if h.allow_groups is not none %}AllowGroups {{ h.allow_groups }}
{% endif %}
{% if h.deny_users is not none %}DenyUsers {{ h.deny_users }}
{% endif %}
{% if h.deny_groups is not none %}DenyGroups {{ h.deny_groups }}
{% endif %}
{% if h.banner is not none %}Banner {{ h.banner }}
{% endif %}
